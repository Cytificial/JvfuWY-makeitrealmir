enum UserStatus {
    INVITED
    VERIFIED
}

model User {
    id               String       @id @default(uuid())
    name             String?
    email            String?      @unique
    pictureUrl       String?      @default('https://i.imgur.com/ZdJSK3Y.jpeg')
    tokenInvitation  String?

    stripeCustomerId String?

    status           UserStatus   @default(VERIFIED)

    // this is the role of the user for the application
    globalRole       String       @default('USER')
    password         String?      @password @omit
    createdAt        DateTime     @default(now())
    updatedAt        DateTime     @updatedAt @default(now())

    images           Image[]      @relation("user")
    collections      Collection[] @relation("user")

    @@auth()
    @@allow("all", auth().id == this.id)
    @@allow('all', auth().globalRole == 'ADMIN')

    //we only allow that user to register if they don't create an admin role
    @@allow("create", globalRole != 'ADMIN')
    @@allow("read", true)
}

model Model {

    id          String   @id @default(uuid())
    name        String?
    type        String?
    description String?
    isActive    Boolean

    images      Image[]  @relation("model")
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt @default(now())
    @@allow("all", true)
}

model Image {

    id                             String            @id @default(uuid())
    prompt                         String?
    imageUrl                       String?
    width                          Float?
    height                         Float?
    quality                        String?
    status                         String?
    downloadCount                  Float
    shareUrl                       String?

    userId                         String?
    user                           User?             @relation(fields: [userId], references: [id], name: "user")
    modelId                        String?
    model                          Model?            @relation(fields: [modelId], references: [id], name: "model")

    imageVariationsAsOriginalImage ImageVariation[]  @relation("originalImage")
    parameters                     Parameter[]       @relation("image")
    collectionImages               CollectionImage[] @relation("image")
    createdAt                      DateTime          @default(now())
    updatedAt                      DateTime          @updatedAt @default(now())
    @@allow("all", true)
}

model ImageVariation {

    id              String   @id @default(uuid())
    variantImageUrl String?
    status          String?

    originalImageId String?
    originalImage   Image?   @relation(fields: [originalImageId], references: [id], name: "originalImage")

    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt @default(now())
    @@allow("all", true)
}

model Parameter {

    id        String   @id @default(uuid())
    name      String?
    value     String?

    imageId   String?
    image     Image?   @relation(fields: [imageId], references: [id], name: "image")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt @default(now())
    @@allow("all", true)
}

model Collection {

    id               String            @id @default(uuid())
    name             String?
    description      String?

    userId           String?
    user             User?             @relation(fields: [userId], references: [id], name: "user")

    collectionImages CollectionImage[] @relation("collection")
    createdAt        DateTime          @default(now())
    updatedAt        DateTime          @updatedAt @default(now())
    @@allow("all", true)
}

model CollectionImage {

    id           String      @id @default(uuid())

    collectionId String?
    collection   Collection? @relation(fields: [collectionId], references: [id], name: "collection")
    imageId      String?
    image        Image?      @relation(fields: [imageId], references: [id], name: "image")

    createdAt    DateTime    @default(now())
    updatedAt    DateTime    @updatedAt @default(now())
    @@allow("all", true)
}

